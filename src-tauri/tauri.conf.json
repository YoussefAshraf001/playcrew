{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayCrew",
  "version": "0.1.0",
  "identifier": "com.playcrew.app",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../src-tauri/web",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "PlayCrew",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../src-tauri/next-server", "../src-tauri/node-runtime"]
  }
}
